# PostgreSQL Database Connection (Standard or pgvector-enabled instance)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_inventory
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=smart_inventory

# Next.js Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Smart Inventory Management System"

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_pes_university_dbms_l3
BCRYPT_SALT_ROUNDS=10

# Vector Embeddings Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
